<?xml version="1.0"?>
<package format="3">
  <name>m20_vlmnav</name>
  <version>0.1.0</version>
  <description>Real-time B (NaVILA-style): a VLM picks the next short move from camera frames; Nav2 behaviors execute it.</description>
  <maintainer email="todo@example.com">M20 Autonomy Team</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>m20_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
