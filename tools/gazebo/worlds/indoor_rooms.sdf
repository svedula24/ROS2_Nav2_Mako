<?xml version="1.0" ?>
<!-- Indoor test site for the M20 stack on Gazebo Harmonic: a 16 x 12 m floor, an outer wall, two inner walls with
     doorways (three rooms), and a few box obstacles with distinct colours. Origin = the robot spawn in room A.
     Props (fridge, ladder, cone, trash can...) are added by tools/gazebo/props.py once the stack runs here. -->
<sdf version="1.9">
  <world name="indoor_rooms">
    <physics name="1ms" type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background><shadows>true</shadows></scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.3 -1</direction>
    </light>
    <light type="point" name="room_a"><pose>-3 0 2.8 0 0 0</pose><diffuse>0.7 0.7 0.65 1</diffuse><attenuation><range>12</range><linear>0.08</linear></attenuation></light>
    <light type="point" name="room_b"><pose>3 3 2.8 0 0 0</pose><diffuse>0.7 0.7 0.65 1</diffuse><attenuation><range>12</range><linear>0.08</linear></attenuation></light>
    <light type="point" name="room_c"><pose>3 -3 2.8 0 0 0</pose><diffuse>0.7 0.7 0.65 1</diffuse><attenuation><range>12</range><linear>0.08</linear></attenuation></light>

    <model name="floor"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>16 12</size></plane></geometry>
        <surface><friction><ode><mu>1.0</mu></ode></friction></surface></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>16 12</size></plane></geometry>
        <material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material></visual>
    </link></model>

    <!-- outer walls: 16 x 12 m, 3 m high, 0.2 m thick -->
    <model name="wall_n"><static>true</static><pose>0 6.1 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>16.4 0.2 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16.4 0.2 3</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -6.1 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>16.4 0.2 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16.4 0.2 3</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>8.1 0 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 12.4 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 12.4 3</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-8.1 0 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 12.4 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 12.4 3</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.9 0.9 0.87 1</diffuse></material></visual></link></model>

    <!-- inner wall at x = 0 with a 1.8 m doorway centred at y = 0 (room A west of it) -->
    <model name="wall_mid_n"><static>true</static><pose>0 3.45 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 5.1 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 5.1 3</size></box></geometry><material><ambient>0.8 0.82 0.85 1</ambient><diffuse>0.85 0.87 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_mid_s"><static>true</static><pose>0 -3.45 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 5.1 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 5.1 3</size></box></geometry><material><ambient>0.8 0.82 0.85 1</ambient><diffuse>0.85 0.87 0.9 1</diffuse></material></visual></link></model>
    <!-- inner wall at y = 0 east of x = 1.2 (a 1.2 m lobby behind the doorway: measured 2026-10-26, a wall starting
         at x = 0 bisected the doorway into two 0.6 m gaps), doorway 1.4 m at x = 4 (rooms B north, C south) -->
    <model name="wall_east_w"><static>true</static><pose>2.25 0 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>2.1 0.2 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2.1 0.2 3</size></box></geometry><material><ambient>0.8 0.82 0.85 1</ambient><diffuse>0.85 0.87 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_east_e"><static>true</static><pose>6.35 0 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>3.3 0.2 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3.3 0.2 3</size></box></geometry><material><ambient>0.8 0.82 0.85 1</ambient><diffuse>0.85 0.87 0.9 1</diffuse></material></visual></link></model>

    <!-- obstacles: a low crate (lidar-blind, camera must see it), a tall cabinet, a pillar -->
    <model name="crate_low"><static>true</static><pose>-4 -2 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.6 0.6 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.6 0.6 0.3</size></box></geometry><material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.65 0.4 0.15 1</diffuse></material></visual></link></model>
    <model name="cabinet"><static>true</static><pose>-6.5 3.5 0.9 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.5 1.2 1.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 1.2 1.8</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="pillar"><static>true</static><pose>4 3 1.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>3</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>3</length></cylinder></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link></model>
    <model name="red_box"><static>true</static><pose>5 -3.5 0.4 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry><material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual></link></model>

    <!-- props the detector can name (Gazebo Fuel, OpenRobotics; downloaded once into the host cache ~/m20_sim/gz_fuel) -->
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Refrigerator</uri><name>refrigerator</name><pose>7.3 4.8 0 0 0 3.14159</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ladder_01</uri><name>ladder</name><pose>1.5 5.2 0 0 0 0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TrashBin</uri><name>trash_can</name><pose>-2.5 4.8 0 0 0 0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction%20Cone</uri><name>traffic_cone</name><pose>6.0 -2.0 0 0 0 0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Desk</uri><name>desk</name><pose>-6.0 -3.5 0 0 0 1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/OfficeChairBlack</uri><name>office_chair</name><pose>-5.0 -3.5 0 0 0 -1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire%20Extinguisher</uri><name>fire_extinguisher</name><pose>2.0 -5.5 0 0 0 0</pose></include>

    <include><uri>model://m20</uri><name>m20</name><pose>-4 0 0 0 0 0</pose></include>
  </world>
</sdf>
